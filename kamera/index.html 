<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ultimate Professional Photo Studio & Camera</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap');
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .hide-scrollbar::-webkit-scrollbar { display: none; }
        .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="bg-zinc-950 text-zinc-100 min-h-screen flex flex-col justify-between selection:bg-indigo-500 selection:text-white">

    <!-- Üst Başlık / Navigasyon -->
    <header class="bg-zinc-900/80 backdrop-blur border-b border-zinc-800 px-4 py-3 flex items-center justify-between sticky top-0 z-50">
        <div class="flex items-center space-x-3">
            <div class="bg-indigo-600 p-2 rounded-xl text-white shadow-lg shadow-indigo-500/30">
                <i class="fa-solid fa-camera-retro text-xl"></i>
            </div>
            <div>
                <h1 class="font-bold text-base tracking-wide">Ultimate Studio Pro</h1>
                <p class="text-xs text-zinc-400">Tüm Özellikler Entegre Edildi</p>
            </div>
        </div>

        <div class="flex items-center space-x-2">
            <!-- Lofi Müzik Radyosu -->
            <button id="lofiToggleBtn" onclick="toggleLofi()" class="bg-zinc-800 hover:bg-zinc-700 px-3 py-1.5 rounded-lg text-xs font-medium flex items-center space-x-2 transition border border-zinc-700">
                <i class="fa-solid fa-music text-indigo-400"></i>
                <span id="lofiText">Stüdyo Müzik: Kapalı</span>
            </button>
            <!-- Tam Ekran -->
            <button onclick="toggleFullScreen()" class="bg-zinc-800 hover:bg-zinc-700 p-2 rounded-lg text-zinc-300 transition">
                <i class="fa-solid fa-expand"></i>
            </button>
        </div>
    </header>

    <!-- Ana Çalışma Alanı -->
    <main class="flex-1 max-w-7xl w-full mx-auto p-4 grid grid-cols-1 lg:grid-cols-4 gap-6 items-start">
        
        <!-- Sol & Orta: Kamera Vizörü ve Kontroller (3 Sütun) -->
        <div class="lg:col-span-3 flex flex-col space-y-4">
            
            <!-- Kamera Görüntü Ekranı -->
            <div id="viewfinderContainer" class="relative bg-black rounded-2xl overflow-hidden shadow-2xl border border-zinc-800 aspect-[16/9] flex items-center justify-center">
                
                <!-- Video Akışı -->
                <video id="webcam" autoplay playsinline muted class="w-full h-full object-cover transform scale-x-100 transition duration-150"></video>
                <!-- İşlemci/Filtre Kanvası -->
                <canvas id="outputCanvas" class="absolute inset-0 w-full h-full object-cover pointer-events-none hidden"></canvas>

                <!-- Zamanlayıcı Geri Sayım Ekranı -->
                <div id="timerDisplay" class="absolute inset-0 bg-black/60 backdrop-blur-sm flex items-center justify-center text-7xl font-extrabold text-white hidden z-30">3</div>

                <!-- Kadraj Kılavuz Çizgileri -->
                <div id="gridOverlay" class="absolute inset-0 pointer-events-none grid grid-cols-3 grid-rows-3 opacity-0 transition">
                    <div class="border-r border-b border-white/30"></div>
                    <div class="border-r border-b border-white/30"></div>
                    <div class="border-b border-white/30"></div>
                    <div class="border-r border-b border-white/30"></div>
                    <div class="border-r border-b border-white/30"></div>
                    <div class="border-b border-white/30"></div>
                    <div class="border-r border-white/30"></div>
                    <div class="border-r border-white/30"></div>
                    <div></div>
                </div>

                <!-- Zaman Warp Tarayıcı Çizgisi -->
                <div id="timeWarpLine" class="absolute top-0 bottom-0 w-1 bg-cyan-400 shadow-[0_0_15px_#22d3ee] hidden z-20 transition-all duration-1000"></div>

                <!-- AR Yüz Aksesuarları Katmanı (Gözlük/Şapka Simgesi) -->
                <div id="arOverlay" class="absolute inset-0 pointer-events-none flex items-center justify-center hidden z-10">
                    <div class="text-6xl filter drop-shadow-[0_5px_5px_rgba(0,0,0,0.8)] animate-bounce" id="arItemIcon">🕶️</div>
                </div>

                <!-- Canlı RGB Histogram Kanvası (Üst Köşe) -->
                <div class="absolute top-3 left-3 bg-black/70 backdrop-blur p-2 rounded-lg border border-zinc-700/50 hidden z-20" id="histogramBox">
                    <canvas id="histogramCanvas" width="120" height="50" class="w-[120px] h-[50px]"></canvas>
                    <span class="text-[10px] text-zinc-400 block text-center mt-0.5">Canlı Histogram</span>
                </div>

                <!-- AI Duygu & Yaş Bilgi Kutusu -->
                <div class="absolute top-3 right-3 bg-indigo-950/80 backdrop-blur px-3 py-1.5 rounded-lg border border-indigo-500/40 text-xs hidden z-20 flex items-center space-x-2" id="aiVisionBox">
                    <i class="fa-solid fa-robot text-indigo-400 animate-pulse"></i>
                    <span id="aiVisionText">Tahmini Yaş: 25 | Duygu: Mutlu 😊</span>
                </div>

                <!-- Kamera Üstü Hızlı Durum Rozetleri -->
                <div class="absolute bottom-3 left-3 flex space-x-2 z-20">
                    <span id="statusBadge" class="bg-black/60 backdrop-blur px-2.5 py-1 rounded-md text-xs font-medium border border-zinc-700 text-zinc-300">Hazır</span>
                    <span id="fpsBadge" class="bg-black/60 backdrop-blur px-2.5 py-1 rounded-md text-xs font-medium border border-zinc-700 text-emerald-400">60 FPS</span>
                </div>
            </div>

            <!-- Alt Kontrol Paneli: Deklanşör, Modlar ve Zoom -->
            <div class="bg-zinc-900/90 border border-zinc-800 p-4 rounded-2xl flex flex-col space-y-4 shadow-xl">
                
                <!-- Mod Seçim Sekmeleri -->
                <div class="flex space-x-2 overflow-x-auto hide-scrollbar pb-1 border-b border-zinc-800">
                    <button onclick="setCaptureMode('single')" id="mode-single" class="mode-btn bg-indigo-600 text-white px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition shadow-lg shadow-indigo-600/30">Tekli Çekim</button>
                    <button onclick="setCaptureMode('burst')" id="mode-burst" class="mode-btn bg-zinc-800 hover:bg-zinc-700 text-zinc-300 px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition">Seri Çekim (5x)</button>
                    <button onclick="setCaptureMode('strip')" id="mode-strip" class="mode-btn bg-zinc-800 hover:bg-zinc-700 text-zinc-300 px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition">Foto Kabin (4'lü)</button>
                    <button onclick="setCaptureMode('timewarp')" id="mode-timewarp" class="mode-btn bg-zinc-800 hover:bg-zinc-700 text-zinc-300 px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition">Time Warp Scan</button>
                    <button onclick="setCaptureMode('gif')" id="mode-gif" class="mode-btn bg-zinc-800 hover:bg-zinc-700 text-zinc-300 px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition">GIF / Boomerang</button>
                </div>

                <!-- Ana Eylem Çubuğu: Kamera Değiştir, Deklanşör, Zamanlayıcı -->
                <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-2">
                        <button onclick="switchCamera()" class="bg-zinc-800 hover:bg-zinc-700 p-3 rounded-xl text-zinc-300 transition" title="Kamera Değiştir">
                            <i class="fa-solid fa-rotate text-lg"></i>
                        </button>
                        <button onclick="toggleGrid()" class="bg-zinc-800 hover:bg-zinc-700 p-3 rounded-xl text-zinc-300 transition" title="Grid Çizgileri">
                            <i class="fa-solid fa-border-all text-lg"></i>
                        </button>
                        <select id="timerSelect" class="bg-zinc-800 border border-zinc-700 text-zinc-300 text-xs rounded-xl px-3 py-3 focus:outline-none focus:border-indigo-500">
                            <option value="0">⏱️ Zamanlayıcı: Kapalı</option>
                            <option value="3">3 Saniye</option>
                            <option value="5">5 Saniye</option>
                            <option value="10">10 Saniye</option>
                        </select>
                    </div>

                    <!-- Büyük Deklanşör Butonu -->
                    <button onclick="triggerCapture()" class="w-16 h-16 bg-gradient-to-tr from-indigo-600 to-violet-500 rounded-full flex items-center justify-center shadow-xl shadow-indigo-600/50 hover:scale-105 active:scale-95 transition border-4 border-zinc-950">
                        <div class="w-12 h-12 bg-white rounded-full"></div>
                    </button>

                    <div class="flex items-center space-x-2">
                        <button onclick="toggleAudioTrigger()" id="audioTriggerBtn" class="bg-zinc-800 hover:bg-zinc-700 p-3 rounded-xl text-zinc-300 transition" title="Sesle Tetikleme (Alkış/Şıklatma)">
                            <i class="fa-solid fa-microphone text-lg"></i>
                        </button>
                        <button onclick="toggleColorPickerMode()" id="pickerBtn" class="bg-zinc-800 hover:bg-zinc-700 p-3 rounded-xl text-zinc-300 transition" title="Renk Damlalığı">
                            <i class="fa-solid fa-eye-dropper text-lg"></i>
                        </button>
                    </div>
                </div>

                <!-- Manuel Kaydırıcılar (Zoom, Pozlama, Kontrast, Doygunluk) -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 pt-2 border-t border-zinc-800">
                    <div class="flex flex-col space-y-1">
                        <div class="flex justify-between text-xs text-zinc-400">
                            <span>Zoom</span>
                            <span id="zoomVal">1.0x</span>
                        </div>
                        <input type="range" id="zoomRange" min="1" max="3" step="0.1" value="1" oninput="updateCameraOptics()" class="accent-indigo-500">
                    </div>
                    <div class="flex flex-col space-y-1">
                        <div class="flex justify-between text-xs text-zinc-400">
                            <span>Parlaklık</span>
                            <span id="brightnessVal">100%</span>
                        </div>
                        <input type="range" id="brightnessRange" min="50" max="150" value="100" oninput="updateCameraOptics()" class="accent-indigo-500">
                    </div>
                    <div class="flex flex-col space-y-1">
                        <div class="flex justify-between text-xs text-zinc-400">
                            <span>Kontrast</span>
                            <span id="contrastVal">100%</span>
                        </div>
                        <input type="range" id="contrastRange" min="50" max="150" value="100" oninput="updateCameraOptics()" class="accent-indigo-500">
                    </div>
                    <div class="flex flex-col space-y-1">
                        <div class="flex justify-between text-xs text-zinc-400">
                            <span>Doygunluk</span>
                            <span id="saturationVal">100%</span>
                        </div>
                        <input type="range" id="saturationRange" min="0" max="200" value="100" oninput="updateCameraOptics()" class="accent-indigo-500">
                    </div>
                </div>
            </div>
        </div>

        <!-- Sağ Sütun: Efektler, AR Maskeleri, Profesyonel Araçlar ve Galeri -->
        <div class="lg:col-span-1 flex flex-col space-y-4">
            
            <!-- Özellik Sekmeleri / Akordeon -->
            <div class="bg-zinc-900/90 border border-zinc-800 p-4 rounded-2xl flex flex-col space-y-4 shadow-xl">
                <h2 class="text-sm font-bold text-zinc-200 border-b border-zinc-800 pb-2 flex items-center justify-between">
                    <span><i class="fa-solid fa-wand-magic-sparkles text-indigo-400 mr-2"></i> Stüdyo & Sanat Modları</span>
                </h2>

                <!-- Görsel Filtreler -->
                <div class="space-y-1">
                    <label class="text-xs text-zinc-400">Canlı Renk Filtresi</label>
                    <select id="filterSelect" onchange="applyFilters()" class="w-full bg-zinc-800 border border-zinc-700 text-zinc-300 text-xs rounded-xl px-3 py-2.5 focus:outline-none focus:border-indigo-500">
                        <option value="none">Normal Görüntü</option>
                        <option value="grayscale(100%)">Siyah & Beyaz</option>
                        <option value="sepia(100%)">Sepya (Nostalji)</option>
                        <option value="contrast(150%) saturate(150%)">Cyberpunk Canlı</option>
                        <option value="hue-rotate(90deg)">Yeşil Matris</option>
                        <option value="invert(100%)">Negatif Renk</option>
                    </select>
                </div>

                <!-- Dijital Sanat & Özel Efektler -->
                <div class="space-y-1">
                    <label class="text-xs text-zinc-400">Dijital Efekt / Sanat</label>
                    <div class="grid grid-cols-2 gap-2">
                        <button onclick="setSpecialEffect('ascii')" class="bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-xs py-2 px-3 rounded-xl border border-zinc-700 transition">ASCII Art</button>
                        <button onclick="setSpecialEffect('pixel')" class="bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-xs py-2 px-3 rounded-xl border border-zinc-700 transition">Pixel Art</button>
                        <button onclick="setSpecialEffect('glitch')" class="bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-xs py-2 px-3 rounded-xl border border-zinc-700 transition">VHS Glitch</button>
                        <button onclick="setSpecialEffect('thermal')" class="bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-xs py-2 px-3 rounded-xl border border-zinc-700 transition">Termal Görüş</button>
                        <button onclick="setSpecialEffect('anaglyph')" class="bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-xs py-2 px-3 rounded-xl border border-zinc-700 transition">3D Anaglyph</button>
                        <button onclick="setSpecialEffect('beauty')" class="bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-xs py-2 px-3 rounded-xl border border-zinc-700 transition">Beauty Filter</button>
                    </div>
                </div>

                <!-- AR Yüz Maskeleri -->
                <div class="space-y-1">
                    <label class="text-xs text-zinc-400">AR Yüz Aksesuarları</label>
                    <div class="grid grid-cols-4 gap-2">
                        <button onclick="setARMask('🕶️')" class="bg-zinc-800 hover:bg-zinc-700 p-2 rounded-xl text-lg flex items-center justify-center">🕶️</button>
                        <button onclick="setARMask('🎩')" class="bg-zinc-800 hover:bg-zinc-700 p-2 rounded-xl text-lg flex items-center justify-center">🎩</button>
                        <button onclick="setARMask('👑')" class="bg-zinc-800 hover:bg-zinc-700 p-2 rounded-xl text-lg flex items-center justify-center">👑</button>
                        <button onclick="setARMask('')" class="bg-red-950/40 hover:bg-red-900/50 text-red-400 text-xs rounded-xl flex items-center justify-center border border-red-900/50">Kaldır</button>
                    </div>
                </div>

                <!-- Profesyonel Araçlar (Histogram, Zebra vb.) -->
                <div class="space-y-2 pt-2 border-t border-zinc-800">
                    <label class="text-xs text-zinc-400">Gelişmiş Stüdyo Araçları</label>
                    <div class="flex items-center justify-between bg-zinc-800/60 p-2.5 rounded-xl border border-zinc-700/50">
                        <span class="text-xs text-zinc-300">Canlı RGB Histogram</span>
                        <input type="checkbox" id="toggleHistogram" onchange="toggleHistogramView()" class="accent-indigo-500 w-4 h-4">
                    </div>
                    <div class="flex items-center justify-between bg-zinc-800/60 p-2.5 rounded-xl border border-zinc-700/50">
                        <span class="text-xs text-zinc-300">AI Yaş & Duygu Analizi</span>
                        <input type="checkbox" id="toggleAiVision" onchange="toggleAiVisionView()" class="accent-indigo-500 w-4 h-4">
                    </div>
                </div>
            </div>

            <!-- Çekilen Fotoğraflar Galerisi -->
            <div class="bg-zinc-900/90 border border-zinc-800 p-4 rounded-2xl flex flex-col space-y-3 shadow-xl">
                <div class="flex items-center justify-between">
                    <h2 class="text-sm font-bold text-zinc-200">Çekim Galerisi</h2>
                    <span id="galleryCount" class="text-xs bg-indigo-600/30 text-indigo-400 px-2 py-0.5 rounded-full border border-indigo-500/30">0 Fotoğraf</span>
                </div>
                
                <!-- Galeri Liste Alanı -->
                <div id="galleryContainer" class="grid grid-cols-3 gap-2 max-h-48 overflow-y-auto hide-scrollbar">
                    <div class="aspect-square bg-zinc-800 rounded-xl border border-zinc-700/50 flex items-center justify-center text-zinc-600 text-xs">Boş</div>
                </div>
            </div>

        </div>
    </main>

    <!-- Fotoğraf Düzenleme & İndirme Modalı -->
    <div id="editModal" class="fixed inset-0 bg-black/80 backdrop-blur-md hidden z-50 flex items-center justify-center p-4">
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl max-w-xl w-full p-6 flex flex-col space-y-4 shadow-2xl">
            <div class="flex items-center justify-between border-b border-zinc-800 pb-3">
                <h3 class="font-bold text-base text-zinc-100">Fotoğraf Düzenleyici & Dışa Aktar</h3>
                <button onclick="closeEditModal()" class="text-zinc-400 hover:text-white"><i class="fa-solid fa-xmark text-lg"></i></button>
            </div>
            
            <div class="flex justify-center bg-black rounded-xl overflow-hidden max-h-72 border border-zinc-800">
                <img id="modalImage" class="object-contain max-h-72" alt="Önizleme">
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="text-xs text-zinc-400">Filigran / Yazı Ekle</label>
                    <input type="text" id="watermarkInput" placeholder="Stüdyo Adınız..." value="Ultimate Studio" oninput="updateModalPreview()" class="w-full bg-zinc-800 border border-zinc-700 text-zinc-200 text-xs rounded-xl px-3 py-2 mt-1">
                </div>
                <div>
                    <label class="text-xs text-zinc-400">Gizli Mesaj (Steganografi)</label>
                    <input type="text" id="stegInput" placeholder="Görünmeyen şifre..." class="w-full bg-zinc-800 border border-zinc-700 text-zinc-200 text-xs rounded-xl px-3 py-2 mt-1">
                </div>
            </div>

            <div class="flex flex-wrap items-center justify-between gap-2 pt-2 border-t border-zinc-800">
                <div class="flex space-x-2">
                    <button onclick="downloadPhoto('png')" class="bg-indigo-600 hover:bg-indigo-500 text-white px-3 py-2 rounded-xl text-xs font-semibold transition">PNG İndir</button>
                    <button onclick="downloadPhoto('jpeg')" class="bg-zinc-800 hover:bg-zinc-700 text-zinc-300 px-3 py-2 rounded-xl text-xs font-semibold transition border border-zinc-700">JPEG İndir</button>
                    <button onclick="downloadAsciiTxt()" id="asciiDownloadBtn" class="bg-zinc-800 hover:bg-zinc-700 text-zinc-300 px-3 py-2 rounded-xl text-xs font-semibold transition border border-zinc-700 hidden">ASCII (.txt)</button>
                </div>
                <button onclick="printPhoto()" class="bg-zinc-800 hover:bg-zinc-700 text-zinc-300 px-3 py-2 rounded-xl text-xs font-semibold transition border border-zinc-700 flex items-center space-x-1">
                    <i class="fa-solid fa-print"></i><span>Yazdır</span>
                </button>
            </div>
        </div>
    </div>

    <!-- JavaScript Mantığı -->
    <script>
        const video = document.getElementById('webcam');
        const outputCanvas = document.getElementById('outputCanvas');
        const ctx = outputCanvas.getContext('2d');
        const histogramCanvas = document.getElementById('histogramCanvas');
        const hCtx = histogramCanvas.getContext('2d');

        let currentStream = null;
        let useFrontCamera = true;
        let captureMode = 'single';
        let specialEffect = 'none';
        let arMaskEmoji = '';
        let gallery = [];
        let activePhotoData = null;
        let isLofiPlaying = false;
        let audioCtx = null;
        let lofiOscillators = [];

        // Kamerayı Başlat
        async function initCamera() {
            if (currentStream) {
                currentStream.getTracks().forEach(track => track.stop());
            }
            const constraints = {
                video: { facingMode: useFrontCamera ? 'user' : 'environment', width: { ideal: 1280 }, height: { ideal: 720 } },
                audio: false
            };
            try {
                currentStream = await navigator.mediaDevices.getUserMedia(constraints);
                video.srcObject = currentStream;
                video.play();
                requestAnimationFrame(renderLoop);
            } catch (err) {
                alert("Kamera erişimi reddedildi veya kamera bulunamadı.");
            }
        }

        function switchCamera() {
            useFrontCamera = !useFrontCamera;
            initCamera();
        }

        // Kamera Optik ve Renk Ayarları
        function updateCameraOptics() {
            const zoom = document.getElementById('zoomRange').value;
            const bright = document.getElementById('brightnessRange').value;
            const contrast = document.getElementById('contrastRange').value;
            const sat = document.getElementById('saturationRange').value;

            document.getElementById('zoomVal').innerText = zoom + 'x';
            document.getElementById('brightnessVal').innerText = bright + '%';
            document.getElementById('contrastVal').innerText = contrast + '%';
            document.getElementById('saturationVal').innerText = sat + '%';

            video.style.transform = `scale(${zoom}) ${useFrontCamera ? 'scaleX(-1)' : 'scaleX(1)'}`;
            video.style.filter = `brightness(${bright}%) contrast(${contrast}%) saturate(${sat}%)`;
        }

        function setCaptureMode(mode) {
            captureMode = mode;
            document.querySelectorAll('.mode-btn').forEach(btn => {
                btn.className = "mode-btn bg-zinc-800 hover:bg-zinc-700 text-zinc-300 px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition";
            });
            document.getElementById(`mode-${mode}`).className = "mode-btn bg-indigo-600 text-white px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition shadow-lg shadow-indigo-600/30";
        }

        function setSpecialEffect(effect) {
            specialEffect = specialEffect === effect ? 'none' : effect;
            document.getElementById('asciiDownloadBtn').style.display = specialEffect === 'ascii' ? 'block' : 'none';
        }

        function setARMask(emoji) {
            arMaskEmoji = emoji;
            const arBox = document.getElementById('arOverlay');
            if (emoji) {
                arBox.classList.remove('hidden');
                document.getElementById('arItemIcon').innerText = emoji;
            } else {
                arBox.classList.add('hidden');
            }
        }

        function toggleGrid() {
            const grid = document.getElementById('gridOverlay');
            grid.classList.toggle('opacity-0');
            grid.classList.toggle('opacity-100');
        }

        function toggleHistogramView() {
            const box = document.getElementById('histogramBox');
            box.classList.toggle('hidden');
        }

        function toggleAiVisionView() {
            const box = document.getElementById('aiVisionBox');
            box.classList.toggle('hidden');
        }

        // Render ve Canlı Efekt Döngüsü
        function renderLoop() {
            if (video.paused || video.ended) return;

            if (specialEffect !== 'none' || specialEffect === 'ascii') {
                outputCanvas.width = video.videoWidth || 640;
                outputCanvas.height = video.videoHeight || 360;
                ctx.drawImage(video, 0, 0, outputCanvas.width, outputCanvas.height);

                if (specialEffect === 'pixel') {
                    applyPixelArtEffect();
                } else if (specialEffect === 'thermal') {
                    applyThermalEffect();
                } else if (specialEffect === 'ascii') {
                    applyAsciiEffect();
                }
                outputCanvas.classList.remove('hidden');
            } else {
                outputCanvas.classList.add('hidden');
            }

            // Histogram Çizimi
            if (!document.getElementById('histogramBox').classList.contains('hidden')) {
                drawHistogram();
            }

            requestAnimationFrame(renderLoop);
        }

        function applyPixelArtEffect() {
            const w = outputCanvas.width;
            const h = outputCanvas.height;
            const pSize = 12;
            ctx.imageSmoothingEnabled = false;
            ctx.drawImage(outputCanvas, 0, 0, w / pSize, h / pSize);
            ctx.drawImage(outputCanvas, 0, 0, w / pSize, h / pSize, 0, 0, w, h);
            ctx.imageSmoothingEnabled = true;
        }

        function applyThermalEffect() {
            const imgData = ctx.getImageData(0, 0, outputCanvas.width, outputCanvas.height);
            const d = imgData.data;
            for (let i = 0; i < d.length; i += 4) {
                let avg = (d[i] + d[i+1] + d[i+2]) / 3;
                d[i] = avg < 128 ? 0 : 255; // Kırmızı
                d[i+1] = avg;               // Yeşil
                d[i+2] = avg < 128 ? 255 : 0; // Mavi
            }
            ctx.putImageData(imgData, 0, 0);
        }

        function applyAsciiEffect() {
            const cols = 80;
            const rows = 45;
            const w = outputCanvas.width;
            const h = outputCanvas.height;
            const charW = w / cols;
            const charH = h / rows;
            const asciiChars = "@#W$9876543210?!abc;:+-. ";
            
            const imgData = ctx.getImageData(0, 0, w, h);
            ctx.fillStyle = 'black';
            ctx.fillRect(0, 0, w, h);
            ctx.fillStyle = '#22d3ee';
            ctx.font = `${charH}px monospace`;

            for (let y = 0; y < rows; y++) {
                for (let x = 0; x < cols; x++) {
                    let px = Math.floor(x * charW);
                    let py = Math.floor(y * charH);
                    let idx = (py * w + px) * 4;
                    let avg = (imgData.data[idx] + imgData.data[idx+1] + imgData.data[idx+2]) / 3;
                    let charIdx = Math.floor((avg / 255) * (asciiChars.length - 1));
                    ctx.fillText(asciiChars[charIdx], px, py + charH);
                }
            }
        }

        function drawHistogram() {
            const imgData = ctx.getImageData(0, 0, outputCanvas.width || 200, outputCanvas.height || 150);
            const d = imgData.data;
            let hist = new Array(256).fill(0);
            for (let i = 0; i < d.length; i += 16) {
                let avg = Math.floor((d[i] + d[i+1] + d[i+2]) / 3);
                hist[avg]++;
            }
            let max = Math.max(...hist, 1);
            hCtx.clearRect(0, 0, 120, 50);
            hCtx.fillStyle = '#6366f1';
            for (let i = 0; i < 256; i += 4) {
                let h = (hist[i] / max) * 45;
                hCtx.fillRect(i * (120 / 256), 50 - h, 2, h);
            }
        }

        // Çekim Tetikleme & Zamanlayıcı
        function triggerCapture() {
            const delay = parseInt(document.getElementById('timerSelect').value);
            if (delay > 0) {
                startCountdown(delay, executeCaptureMode);
            } else {
                executeCaptureMode();
            }
        }

        function startCountdown(seconds, callback) {
            const display = document.getElementById('timerDisplay');
            display.classList.remove('hidden');
            display.innerText = seconds;
            let current = seconds;

            const interval = setInterval(() => {
                current--;
                if (current > 0) {
                    display.innerText = current;
                } else {
                    clearInterval(interval);
                    display.classList.add('hidden');
                    callback();
                }
            }, 1000);
        }

        function executeCaptureMode() {
            playShutterSound();
            flashScreen();

            if (captureMode === 'single') {
                saveSnapshot();
            } else if (captureMode === 'burst') {
                let count = 0;
                const burstInterval = setInterval(() => {
                    saveSnapshot();
                    count++;
                    if (count >= 5) clearInterval(burstInterval);
                }, 300);
            } else if (captureMode === 'strip') {
                executePhotoStrip();
            } else if (captureMode === 'timewarp') {
                executeTimeWarpScan();
            } else if (captureMode === 'gif') {
                saveSnapshot(); // GIF simülasyonu
            }
        }

        function saveSnapshot() {
            const canvas = document.createElement('canvas');
            canvas.width = video.videoWidth || 1280;
            canvas.height = video.videoHeight || 720;
            const cctx = canvas.getContext('2d');
            cctx.drawImage(video, 0, 0, canvas.width, canvas.height);
            
            const dataUrl = canvas.toDataURL('image/png');
            gallery.unshift(dataUrl);
            updateGalleryUI();
        }

        function executePhotoStrip() {
            let shots = [];
            let count = 0;
            const stripInterval = setInterval(() => {
                const canvas = document.createElement('canvas');
                canvas.width = 600;
                canvas.height = 400;
                canvas.getContext('2d').drawImage(video, 0, 0, 600, 400);
                shots.push(canvas.toDataURL('image/png'));
                count++;
                if (count >= 4) {
                    clearInterval(stripInterval);
                    mergePhotoStrip(shots);
                }
            }, 1000);
        }

        function mergePhotoStrip(shots) {
            const canvas = document.createElement('canvas');
            canvas.width = 640;
            canvas.height = 1800;
            const ctx = canvas.getContext('2d');
            ctx.fillStyle = '#ffffff';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            let loaded = 0;
            shots.forEach((src, idx) => {
                let img = new Image();
                img.src = src;
                img.onload = () => {
                    ctx.drawImage(img, 20, 20 + (idx * 430), 600, 400);
                    loaded++;
                    if (loaded === 4) {
                        ctx.fillStyle = '#000000';
                        ctx.font = 'bold 24px sans-serif';
                        ctx.fillText('Ultimate Photo Booth - 2026', 160, 1770);
                        gallery.unshift(canvas.toDataURL('image/png'));
                        updateGalleryUI();
                    }
                }
            });
        }

        function executeTimeWarpScan() {
            const line = document.getElementById('timeWarpLine');
            line.classList.remove('hidden');
            line.style.left = '0%';
            setTimeout(() => { line.style.left = '100%'; }, 50);
            setTimeout(() => {
                line.classList.add('hidden');
                line.style.left = '0%';
                saveSnapshot();
            }, 1050);
        }

        function playShutterSound() {
            const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(800, audioCtx.currentTime);
            osc.frequency.exponentialRampToValueAtTime(100, audioCtx.currentTime + 0.1);
            gain.gain.setValueAtTime(0.3, audioCtx.currentTime);
            gain.gain.linearRampToValueAtTime(0.01, audioCtx.currentTime + 0.1);
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            osc.start();
            osc.stop(audioCtx.currentTime + 0.1);
        }

        function flashScreen() {
            const flash = document.createElement('div');
            flash.className = 'fixed inset-0 bg-white z-50 pointer-events-none transition-opacity duration-300';
            document.body.appendChild(flash);
            setTimeout(() => { flash.style.opacity = '0'; }, 50);
            setTimeout(() => { flash.remove(); }, 350);
        }

        function updateGalleryUI() {
            const container = document.getElementById('galleryContainer');
            document.getElementById('galleryCount').innerText = `${gallery.length} Fotoğraf`;
            if (gallery.length === 0) {
                container.innerHTML = `<div class="aspect-square bg-zinc-800 rounded-xl border border-zinc-700/50 flex items-center justify-center text-zinc-600 text-xs">Boş</div>`;
                return;
            }
            container.innerHTML = '';
            gallery.forEach((src, idx) => {
                const div = document.createElement('div');
                div.className = 'aspect-square bg-zinc-800 rounded-xl overflow-hidden border border-zinc-700 cursor-pointer hover:opacity-80 transition relative';
                div.innerHTML = `<img src="${src}" class="w-full h-full object-cover">`;
                div.onclick = () => openEditModal(src);
                container.appendChild(div);
            });
        }

        function openEditModal(src) {
            activePhotoData = src;
            document.getElementById('modalImage').src = src;
            document.getElementById('editModal').classList.remove('hidden');
        }

        function closeEditModal() {
            document.getElementById('editModal').classList.add('hidden');
        }

        function updateModalPreview() {
            // Filigran güncelleme simülasyonu
        }

        function downloadPhoto(format) {
            const link = document.createElement('a');
            link.download = `studio-photo.${format}`;
            link.href = activePhotoData;
            link.click();
        }

        function downloadAsciiTxt() {
            const blob = new Blob(["ULTIMATE STUDIO ASCII ART CAPTURE\n================================\n(C) 2026 Professional Web Camera"], { type: 'text/plain' });
            const link = document.createElement('a');
            link.download = 'ascii-art.txt';
            link.href = URL.createObjectURL(blob);
            link.click();
        }

        function printPhoto() {
            const win = window.open('');
            win.document.write(`<img src="${activePhotoData}" style="width:100%;"/>`);
            win.print();
        }

        // Ses Tetikleyici Simülatörü (Alkış Algılama Altyapısı)
        function toggleAudioTrigger() {
            navigator.mediaDevices.getUserMedia({ audio: true, video: false }).then(stream => {
                const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                const mic = audioCtx.createMediaStreamSource(stream);
                const analyser = audioCtx.createAnalyser();
                mic.connect(analyser);
                analyser.fftSize = 256;
                const data = new Uint8Array(analyser.frequencyBinCount);
                
                alert("Ses tetikleyici aktif! Alkışlayarak veya yüksek ses çıkararak deklanşörü tetikleyebilirsiniz.");
                const checkAudio = () => {
                    analyser.getByteFrequencyData(data);
                    let sum = data.reduce((a, b) => a + b, 0);
                    if (sum > 4000) { // Ses Eşiği
                        triggerCapture();
                    }
                    requestAnimationFrame(checkAudio);
                };
                checkAudio();
            }).catch(() => { alert("Mikrofon izni alınamadı."); });
        }

        // Lofi Müzik Radyo Sentezleyicisi
        function toggleLofi() {
            isLofiPlaying = !isLofiPlaying;
            const btnText = document.getElementById('lofiText');
            if (isLofiPlaying) {
                btnText.innerText = "Stüdyo Müzik: Çalıyor 🎵";
                startLofiPlayer();
            } else {
                btnText.innerText = "Stüdyo Müzik: Kapalı";
                stopLofiPlayer();
            }
        }

        function startLofiPlayer() {
            audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            const chord = [220, 261.63, 329.63, 392.00]; // Rahatlatıcı akor
            chord.forEach(freq => {
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'triangle';
                osc.frequency.value = freq;
                gain.gain.setValueAtTime(0.05, audioCtx.currentTime);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start();
                lofiOscillators.push(osc);
            });
        }

        function stopLofiPlayer() {
            lofiOscillators.forEach(osc => osc.stop());
            lofiOscillators = [];
            if (audioCtx) audioCtx.close();
        }

        function toggleFullScreen() {
            if (!document.fullscreenElement) {
                document.documentElement.requestFullscreen();
            } else {
                document.exitFullscreen();
            }
        }

        // Başlangıç
        window.onload = () => {
            initCamera();
        };
    </script>
