# LiveKit Cloud veya kendi LiveKit sunucunuzdan alınır
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_API_KEY
LIVEKIT_API_SECRET=YOUR_API_SECRET
PORT=3000

# İsteğe bağlı: bütün odalar için tek ortak parola. Boş bırakılabilir.
ROOM_PASSWORD=

# Üretimde uygulamanızın HTTPS alan adını yazın; örnek: https://telsiz.example.com
ALLOWED_ORIGINS=*
