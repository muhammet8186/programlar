# PMR Tactical Pro - Janus AudioBridge yapılandırması
# Bu dosya Janus'ın varsayılan AudioBridge yapılandırmasının yerine geçer.
# Yeni oda eklemek için room-1234 bloğunu kopyalayıp oda numarasını değiştirin.

general: {
  events = true
}

room-1234: {
  description = "PMR Tactical Pro - Varsayilan Oda"
  secret = "CHANGE_THIS_ROOM_ADMIN_SECRET"
  pin = "pmr1234"
  sampling_rate = 48000
  audiolevel_ext = true
  audiolevel_event = true
  audio_active_packets = 50
  audio_level_average = 25
  record = false
}
