# LiveKit Cloud projenizin WebSocket URL'si (wss:// ile başlamalı)
LIVEKIT_CLOUD_URL=wss://YOUR_PROJECT.livekit.cloud
# LiveKit Cloud Project > Settings / Keys bölümünden alınır; HTML içine koymayın.
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
# Uygulamanın yayınlandığı tam origin; örn. https://pmr.example.com
APP_ORIGIN=https://YOUR_APP_ORIGIN
# Uygulamadaki oda/kanal parolasıyla eşleşen güçlü parola
ROOM_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
