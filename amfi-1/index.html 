        // --- Audio Context & Nodes Variables ---
        let audioCtx = null;
        let micStream = null;
        let micSource = null;
        let micGainNode = null;
        let convolverNode = null;
        let delayNode = null;
        let feedbackGainNode = null;
        let lowpassFilterNode = null;
        let wetGainNode = null;
        let dryGainNode = null;
        let masterGainNode = null;
        let analyserNode = null;
        let destinationStreamNode = null;

        // Recording variables
        let mediaRecorder = null;
        let recordedChunks = [];
        let recordStartTime = 0;
        let recordTimerInterval = null;

        // UI Element References
        const startBtn = document.getElementById('startBtn');
        const startIcon = document.getElementById('startIcon');
        const startText = document.getElementById('startText');
        const statusDot = document.getElementById('statusDot');
        const statusText = document.getElementById('statusText');
        const presetDisplay = document.getElementById('presetDisplay');

        const micGainInput = document.getElementById('micGain');
        const micGainVal = document.getElementById('micGainVal');
        const reverbMixInput = document.getElementById('reverbMix');
        const reverbMixVal = document.getElementById('reverbMixVal');
        const echoTimeInput = document.getElementById('echoTime');
        const echoTimeVal = document.getElementById('echoTimeVal');
        const echoFeedbackInput = document.getElementById('echoFeedback');
        const echoFeedbackVal = document.getElementById('echoFeedbackVal');
        const toneFilterInput = document.getElementById('toneFilter');
        const toneFilterVal = document.getElementById('toneFilterVal');
        const masterVolInput = document.getElementById('masterVol');
        const masterVolVal = document.getElementById('masterVolVal');

        const recordBtn = document.getElementById('recordBtn');
        const stopRecordBtn = document.getElementById('stopRecordBtn');
        const recordTimer = document.getElementById('recordTimer');
        const recordStatus = document.getElementById('recordStatus');
        const audioPlaybackContainer = document.getElementById('audioPlaybackContainer');
        const audioPlayback = document.getElementById('audioPlayback');
        const downloadBtn = document.getElementById('downloadBtn');

        const canvas = document.getElementById('visualizer');
        const canvasCtx = canvas.getContext('2d');
        const vuMeter = document.getElementById('vuMeter');

        let isRunning = false;

        // --- Preset Configurations ---
        const PRESETS = {
            selimiye: {
                name: 'Büyük Selimiye',
                micGain: 1.2,
                reverbMix: 0.55,
                echoTime: 0.24,
                echoFeedback: 0.40,
                toneFilter: 3200,
                reverbDuration: 3.5,
                decay: 2.5
            },
            wood: {
                name: 'Ahşap Kubbe',
                micGain: 1.1,
                reverbMix: 0.35,
                echoTime: 0.15,
                echoFeedback: 0.25,
                toneFilter: 4500,
                reverbDuration: 1.8,
                decay: 3.0
            },
            hall: {
                name: 'Cemiyet Salonu',
                micGain: 1.0,
                reverbMix: 0.25,
                echoTime: 0.10,
                echoFeedback: 0.15,
                toneFilter: 6000,
                reverbDuration: 1.2,
                decay: 4.0
            },
            outdoor: {
                name: 'Açık Alan / Minare',
                micGain: 1.3,
                reverbMix: 0.20,
                echoTime: 0.45,
                echoFeedback: 0.55,
                toneFilter: 2800,
                reverbDuration: 4.0,
                decay: 1.5
            }
        };

        let activePresetKey = 'selimiye';

        // --- Initialize Audio Context & Graph ---
        async function initAudio() {
            try {
                // Request Low Latency Audio Context
                const AudioContext = window.AudioContext || window.webkitAudioContext;
                audioCtx = new AudioContext({ latencyHint: 'interactive' });

                // Request Microphone Access
                micStream = await navigator.mediaDevices.getUserMedia({
                    audio: {
                        echoCancellation: false, // Turned off for natural acoustic feel
                        noiseSuppression: true,
                        autoGainControl: false,
                        latency: 0
                    }
                });

                // Create Audio Nodes
                micSource = audioCtx.createMediaStreamSource(micStream);
                micGainNode = audioCtx.createGain();
                convolverNode = audioCtx.createConvolver();
                delayNode = audioCtx.createDelay(1.0);
                feedbackGainNode = audioCtx.createGain();
                lowpassFilterNode = audioCtx.createBiquadFilter();
                wetGainNode = audioCtx.createGain();
                dryGainNode = audioCtx.createGain();
                masterGainNode = audioCtx.createGain();
                analyserNode = audioCtx.createAnalyser();

                // Setup Filter Type
                lowpassFilterNode.type = 'lowpass';

                // Generate Synthetic Impulse Response for Reverb
                convolverNode.buffer = createImpulseResponse(
                    PRESETS[activePresetKey].reverbDuration,
                    PRESETS[activePresetKey].decay
                );

                // --- AUDIO ROUTING GRAPH ---
                // Mic -> MicGain
                micSource.connect(micGainNode);

                // MicGain -> Dry Path -> Master
                micGainNode.connect(dryGainNode);
                dryGainNode.connect(masterGainNode);

                // MicGain -> Tone Filter
                micGainNode.connect(lowpassFilterNode);

                // Tone Filter -> Convolver (Reverb) -> WetGain
                lowpassFilterNode.connect(convolverNode);
                convolverNode.connect(wetGainNode);

                // Tone Filter -> Delay Loop (Echo)
                lowpassFilterNode.connect(delayNode);
                delayNode.connect(feedbackGainNode);
                feedbackGainNode.connect(delayNode); // Feedback loop
                delayNode.connect(wetGainNode); // Mix echo into wet signal

                // WetGain -> Master
                wetGainNode.connect(masterGainNode);

                // Master -> Analyser & Destination
                masterGainNode.connect(analyserNode);
                analyserNode.connect(audioCtx.destination);

                // Prepare Media Stream Destination for Recorder
                destinationStreamNode = audioCtx.createMediaStreamDestination();
                masterGainNode.connect(destinationStreamNode);

                // Apply initial settings
                applyPresetValues(PRESETS[activePresetKey]);

                // Update UI State
                isRunning = true;
                updateSystemUIState();
                startVisualizer();

                // Enable Recording Controls
                recordBtn.disabled = false;
                recordBtn.classList.remove('bg-slate-800', 'text-slate-500', 'cursor-not-allowed');
                recordBtn.classList.add('bg-red-600/20', 'hover:bg-red-600/30', 'text-red-400', 'border', 'border-red-500/30');

            } catch (err) {
                console.error("Audio initialization failed:", err);
                alert("Mikrofon erişimi sağlanamadı veya ses sistemi başlatılamadı. Lütfen mikrofon izinlerinizi kontrol edin.");
            }
        }

        // --- Generate Synthetic Reverb Impulse Response ---
        function createImpulseResponse(duration, decay) {
            const sampleRate = audioCtx.sampleRate;
            const length = sampleRate * duration;
            const impulse = audioCtx.createBuffer(2, length, sampleRate);
            const left = impulse.getChannelData(0);
            const right = impulse.getChannelData(1);

            for (let i = 0; i < length; i++) {
                const n = i;
                // Exponential decay curve
                const multi = Math.pow(1 - n / length, decay);
                left[i] = (Math.random() * 2 - 1) * multi;
                right[i] = (Math.random() * 2 - 1) * multi;
            }

            return impulse;
        }

        // --- Toggle Start / Stop Audio ---
        startBtn.addEventListener('click', async () => {
            if (!isRunning) {
                await initAudio();
            } else {
                stopAudio();
            }
        });

        function stopAudio() {
            if (audioCtx) {
                audioCtx.close();
            }
            if (micStream) {
                micStream.getTracks().forEach(track => track.stop());
            }

            isRunning = false;
            updateSystemUIState();

            // Disable Record Button
            recordBtn.disabled = true;
            recordBtn.className = "px-4 py-3 rounded-xl font-semibold text-xs transition-all flex items-center justify-center space-x-2 bg-slate-800 text-slate-500 cursor-not-allowed";
        }

        function updateSystemUIState() {
            if (isRunning) {
                startBtn.classList.remove('bg-emerald-600', 'hover:bg-emerald-500');
                startBtn.classList.add('bg-red-600', 'hover:bg-red-500');
                startIcon.className = 'fa-solid fa-microphone-slash';
                startText.textContent = 'Sistemi Durdur';

                statusDot.className = 'w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse';
                statusText.textContent = 'Canlı Ses Aktif';
                statusText.classList.remove('text-slate-400');
                statusText.classList.add('text-emerald-400');
            } else {
                startBtn.classList.remove('bg-red-600', 'hover:bg-red-500');
                startBtn.classList.add('bg-emerald-600', 'hover:bg-emerald-500');
                startIcon.className = 'fa-solid fa-microphone';
                startText.textContent = 'Sistemi Başlat';

                statusDot.className = 'w-2.5 h-2.5 rounded-full bg-red-500';
                statusText.textContent = 'Sistem Kapalı';
                statusText.classList.remove('text-emerald-400');
                statusText.classList.add('text-slate-400');
            }
        }

        // --- Slider Input Handlers & Parameter Mapping ---
        function updateAudioParameters() {
            if (!audioCtx || !isRunning) return;

            const micGain = parseFloat(micGainInput.value);
            const reverbMix = parseFloat(reverbMixInput.value);
            const echoTime = parseFloat(echoTimeInput.value);
            const echoFeedback = parseFloat(echoFeedbackInput.value);
            const toneFilter = parseFloat(toneFilterInput.value);
            const masterVol = parseFloat(masterVolInput.value);

            // Update Audio Nodes smoothly
            micGainNode.gain.setTargetAtTime(micGain, audioCtx.currentTime, 0.02);
            dryGainNode.gain.setTargetAtTime(1 - (reverbMix * 0.5), audioCtx.currentTime, 0.02);
            wetGainNode.gain.setTargetAtTime(reverbMix * 1.2, audioCtx.currentTime, 0.02);

            delayNode.delayTime.setTargetAtTime(echoTime, audioCtx.currentTime, 0.02);
            feedbackGainNode.gain.setTargetAtTime(echoFeedback, audioCtx.currentTime, 0.02);

            lowpassFilterNode.frequency.setTargetAtTime(toneFilter, audioCtx.currentTime, 0.02);
            masterGainNode.gain.setTargetAtTime(masterVol, audioCtx.currentTime, 0.02);

            // Update UI Numerical Labels
            micGainVal.textContent = micGain.toFixed(1) + 'x';
            reverbMixVal.textContent = Math.round(reverbMix * 100) + '%';
            echoTimeVal.textContent = Math.round(echoTime * 1000) + ' ms';
            echoFeedbackVal.textContent = Math.round(echoFeedback * 100) + '%';
            toneFilterVal.textContent = Math.round(toneFilter) + ' Hz';
            masterVolVal.textContent = Math.round(masterVol * 100) + '%';
        }

        // Bind Sliders
        [micGainInput, reverbMixInput, echoTimeInput, echoFeedbackInput, toneFilterInput, masterVolInput].forEach(slider => {
            slider.addEventListener('input', updateAudioParameters);
        });

        // --- Presets Logic ---
        function applyPresetValues(preset) {
            micGainInput.value = preset.micGain;
            reverbMixInput.value = preset.reverbMix;
            echoTimeInput.value = preset.echoTime;
            echoFeedbackInput.value = preset.echoFeedback;
            toneFilterInput.value = preset.toneFilter;

            presetDisplay.textContent = `Preset: ${preset.name}`;

            if (audioCtx && isRunning) {
                // Re-generate Impulse Response for selected room characteristics
                convolverNode.buffer = createImpulseResponse(preset.reverbDuration, preset.decay);
                updateAudioParameters();
            } else {
                // Update text displays manually if not active
                micGainVal.textContent = preset.micGain.toFixed(1) + 'x';
                reverbMixVal.textContent = Math.round(preset.reverbMix * 100) + '%';
                echoTimeVal.textContent = Math.round(preset.echoTime * 1000) + ' ms';
                echoFeedbackVal.textContent = Math.round(preset.echoFeedback * 100) + '%';
                toneFilterVal.textContent = Math.round(preset.toneFilter) + ' Hz';
            }
        }

        // Preset Button Clicks
        document.querySelectorAll('.preset-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.preset-btn').forEach(b => {
                    b.classList.remove('active', 'bg-emerald-950/60', 'border-emerald-500/50', 'text-amber-300');
                    b.classList.add('bg-slate-900/60', 'border-slate-800', 'text-slate-300');
                });

                btn.classList.add('active', 'bg-emerald-950/60', 'border-emerald-500/50', 'text-amber-300');
                btn.classList.remove('bg-slate-900/60', 'border-slate-800', 'text-slate-300');

                const presetKey = btn.getAttribute('data-preset');
                activePresetKey = presetKey;
                applyPresetValues(PRESETS[presetKey]);
            });
        });

        // Reset Sliders Button
        document.getElementById('resetSlidersBtn').addEventListener('click', () => {
            applyPresetValues(PRESETS[activePresetKey]);
        });

        // --- Canvas Visualizer & VU Meter ---
        function resizeCanvas() {
            canvas.width = canvas.parentElement.clientWidth;
            canvas.height = canvas.parentElement.clientHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        function startVisualizer() {
            analyserNode.fftSize = 256;
            const bufferLength = analyserNode.frequencyBinCount;
            const dataArray = new Uint8Array(bufferLength);

            function draw() {
                if (!isRunning) {
                    canvasCtx.clearRect(0, 0, canvas.width, canvas.height);
                    vuMeter.style.width = '0%';
                    return;
                }

                requestAnimationFrame(draw);
                analyserNode.getByteFrequencyData(dataArray);

                // Clear Canvas
                canvasCtx.clearRect(0, 0, canvas.width, canvas.height);

                // Draw Wave/Frequency Bars
                const barWidth = (canvas.width / bufferLength) * 2.2;
                let barHeight;
                let x = 0;

                let totalVolume = 0;

                for (let i = 0; i < bufferLength; i++) {
                    barHeight = (dataArray[i] / 255) * canvas.height * 0.8;
                    totalVolume += dataArray[i];

                    // Subtle Green-Gold Gradient
                    const gradient = canvasCtx.createLinearGradient(0, canvas.height, 0, 0);
                    gradient.addColorStop(0, 'rgba(16, 185, 129, 0.1)');
                    gradient.addColorStop(0.5, 'rgba(234, 179, 8, 0.4)');
                    gradient.addColorStop(1, 'rgba(234, 179, 8, 0.8)');

                    canvasCtx.fillStyle = gradient;
                    canvasCtx.fillRect(x, canvas.height - barHeight, barWidth - 1, barHeight);

                    x += barWidth + 1;
                }

                // Update Output VU Peak Meter
                const averageVol = totalVolume / bufferLength;
                const vuPercent = Math.min(100, Math.round((averageVol / 128) * 100));
                vuMeter.style.width = vuPercent + '%';
            }

            draw();
        }

        // --- Audio Recorder Logic ---
        recordBtn.addEventListener('click', () => {
            if (!isRunning || !destinationStreamNode) return;

            recordedChunks = [];
            const options = { mimeType: 'audio/webm' };
            
            try {
                mediaRecorder = new MediaRecorder(destinationStreamNode.stream, options);
            } catch (e) {
                console.warn("audio/webm not supported, fallback to default");
                mediaRecorder = new MediaRecorder(destinationStreamNode.stream);
            }

            mediaRecorder.ondataavailable = (e) => {
                if (e.data.size > 0) {
                    recordedChunks.push(e.data);
                }
            };

            mediaRecorder.onstop = () => {
                const blob = new Blob(recordedChunks, { type: 'audio/webm' });
                const audioUrl = URL.createObjectURL(blob);
                audioPlayback.src = audioUrl;
                downloadBtn.href = audioUrl;
                audioPlaybackContainer.classList.remove('hidden');
            };

            mediaRecorder.start();
            recordStartTime = Date.now();
            recordStatus.textContent = "Kaydediliyor...";
            recordStatus.className = "text-xs text-red-400 font-medium animate-pulse";

            // Timer Loop
            recordTimerInterval = setInterval(() => {
                const elapsedSeconds = Math.floor((Date.now() - recordStartTime) / 1000);
                const mins = String(Math.floor(elapsedSeconds / 60)).padStart(2, '0');
                const secs = String(elapsedSeconds % 60).padStart(2, '0');
                recordTimer.textContent = `${mins}:${secs}`;
            }, 1000);

            // Toggle Buttons
            recordBtn.disabled = true;
            recordBtn.className = "px-4 py-3 rounded-xl font-semibold text-xs transition-all flex items-center justify-center space-x-2 bg-slate-800 text-slate-500 cursor-not-allowed";

            stopRecordBtn.disabled = false;
            stopRecordBtn.className = "px-4 py-3 rounded-xl font-semibold text-xs transition-all flex items-center justify-center space-x-2 bg-red-600/30 hover:bg-red-600/50 text-red-300 border border-red-500/40 cursor-pointer";
        });

        stopRecordBtn.addEventListener('click', () => {
            if (mediaRecorder && mediaRecorder.state !== 'inactive') {
                mediaRecorder.stop();
                clearInterval(recordTimerInterval);
                recordStatus.textContent = "Kayıt Tamamlandı";
                recordStatus.className = "text-xs text-emerald-400 font-medium";

                stopRecordBtn.disabled = true;
                stopRecordBtn.className = "px-4 py-3 rounded-xl font-semibold text-xs transition-all flex items-center justify-center space-x-2 bg-slate-800 text-slate-500 cursor-not-allowed";

                recordBtn.disabled = false;
                recordBtn.className = "px-4 py-3 rounded-xl font-semibold text-xs transition-all flex items-center justify-center space-x-2 bg-red-600/20 hover:bg-red-600/30 text-red-400 border border-red-500/30 cursor-pointer";
            }
        });
    </script>
